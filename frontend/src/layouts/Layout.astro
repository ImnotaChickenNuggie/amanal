---
import { ViewTransitions } from "astro:transitions";
import Navbar from "../components/Navbar";
import HeroIntro from "../components/HeroIntro";

interface Props {
  title?: string;
  description?: string;
  showIntro?: boolean;
}

const {
  title = "AMANAL // 2026 — Hackathon de Tecnología Líquida",
  description = "Hackathon de 48 horas para la resiliencia de Chapultepec. 14-16 Agosto 2026, Complejo Cultural de Los Pinos, CDMX.",
  showIntro = false,
} = Astro.props;

const ogImage = new URL("/og.png", Astro.site || "https://amanal.dev").href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://amanal.dev").href;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="avantgardev" />
    <meta name="keywords" content="hackathon, CDMX, Chapultepec, tecnología, innovación, datos abiertos, Los Pinos, AMANAL 2026" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="AMANAL // 2026" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme -->
    <meta name="theme-color" content="#0a0d0f" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
  </head>
  <body>
    <!-- Textura de ruido sutil sobre todo el sitio -->
    <div class="noise" aria-hidden="true"></div>

    {showIntro && <HeroIntro client:load />}
    <Navbar client:load transition:persist />
    <slot />

    <style>
      .noise {
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        opacity: 0.03;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
      }
    </style>
  </body>
</html>
