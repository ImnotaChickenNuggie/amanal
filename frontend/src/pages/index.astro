---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Tracks from '../components/Tracks.astro';
import Gallery from '../components/Gallery.astro';
import SedeMap from '../components/SedeMap';
import Partners from '../components/Partners';
import RegistrationZone from '../components/RegistrationZone';
import PassLookup from '../components/PassLookup';
import '../styles/global.css';
---

<Layout showIntro={true}>
	<main>
		<Hero />

		<div class='line-manantial w-full max-w-6xl mx-auto'></div>

		<Partners client:visible />
    
		<Tracks />

		<Gallery />

		<div class='line-manantial w-full max-w-6xl mx-auto'></div>

		<SedeMap client:visible />

		<div class='line-manantial w-full max-w-6xl mx-auto'></div>

		<PassLookup client:visible />

		<div class='line-manantial w-full max-w-6xl mx-auto'></div>

		<RegistrationZone client:visible />

		<div class='line-manantial w-full max-w-6xl mx-auto'></div>

		<!-- Footer -->
		<footer class='px-6 pt-16 pb-10 border-t border-raiz/50'>
			<div class='max-w-6xl mx-auto'>
				<!-- Top: brand + socials -->
				<div class='flex flex-col sm:flex-row items-center justify-between gap-6 mb-10'>
					<div class='text-center sm:text-left'>
						<p class='font-makes font-bold text-4xl text-niebla'>AMANAL <span class='text-musgo font-mono text-sm'>// 2026</span></p>
						<p class='text-musgo text-xs font-product mt-1'>Protocolo de Innovación Abierta para Chapultepec</p>
					</div>
					<div class='flex items-center gap-5'>
						<a href='https://www.tiktok.com' target='_blank' rel='noopener noreferrer' aria-label='TikTok' class='text-musgo hover:text-manantial transition-colors'>
							<svg width='20' height='20' viewBox='0 0 24 24' fill='currentColor'><path d='M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.87a8.16 8.16 0 0 0 4.76 1.52v-3.4a4.85 4.85 0 0 1-1-.3z'/></svg>
						</a>
						<a href='https://www.instagram.com' target='_blank' rel='noopener noreferrer' aria-label='Instagram' class='text-musgo hover:text-manantial transition-colors'>
							<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='2' width='20' height='20' rx='5' ry='5'/><path d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z'/><line x1='17.5' y1='6.5' x2='17.51' y2='6.5'/></svg>
						</a>
						<a href='https://www.facebook.com' target='_blank' rel='noopener noreferrer' aria-label='Facebook' class='text-musgo hover:text-manantial transition-colors'>
							<svg width='20' height='20' viewBox='0 0 24 24' fill='currentColor'><path d='M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z'/></svg>
						</a>
						<a href='https://www.github.com' target='_blank' rel='noopener noreferrer' aria-label='GitHub' class='text-musgo hover:text-manantial transition-colors'>
							<svg width='20' height='20' viewBox='0 0 24 24' fill='currentColor'><path d='M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z'/></svg>
						</a>
					</div>
				</div>

				<div class='h-px bg-gradient-to-r from-transparent via-raiz to-transparent mb-8'></div>

				<!-- Bottom: links + copyright -->
				<div class='flex flex-col sm:flex-row items-center justify-between gap-4'>
					<div class='flex items-center gap-6'>
						<a href='#' class='text-musgo/60 hover:text-musgo text-xs font-product transition-colors'>Términos y Condiciones</a>
						<a href='#' class='text-musgo/60 hover:text-musgo text-xs font-product transition-colors'>Aviso de Privacidad</a>
					</div>
					<p class='text-raiz text-xs font-product'>
						&copy; 2026 AMANAL. Todos los derechos reservados.
					</p>
				</div>
			</div>
		</footer>
	</main>
</Layout>
